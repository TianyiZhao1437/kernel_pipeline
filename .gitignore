# Credentials
#
# models.yaml is the live registry: one entry per model, holding a base URL and
# an API key. models.example.yaml is the committed template with the schema and
# placeholder keys -- that is the half a reader gets, and the half that documents
# what the file is for.
models.yaml
#
# Superseded by models.yaml. Kept ignored so a stray file cannot be committed
# during the changeover; delete these once no consumer reads them.
.env*

# Vendored upstream sources are committed deliberately -- see
# third_party/VENDOR.md. Nothing under it needs to be ignored again.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/

# Pipeline state and outputs.
# Anchored with a leading slash on purpose: an unanchored `data/` also matches
# nested directories, and it silently swallowed three of them inside the
# vendored flashinfer-bench tree -- including flashinfer_bench/data/, which
# holds the Definition/Workload/Solution parsers the whole pipeline validates
# against. Keep these anchored to the repository root.
/data/
/jobs/
/dist/
/logs/

# tools/gen_workload_blobs.py writes the rewritten sweep beside the authored one
# rather than over it, so the diff can be reviewed before promoting by rename.
# The intermediate is a build artefact; the promoted <definition>.jsonl is not.
tasks/*/*.real.jsonl

# The delivery package is 724 MB, 720 MB of which is the 23 workload safetensors
# blobs. It is assembled from this repository by tools/ and handed to the
# customer as a separate artefact -- it is not source, and committing it would
# put a binary blob store in git history. Rebuild it by running the
# task_hca_compress_c128/ README's staging steps; every authoritative input
# lives here in the repository.
/delivery/

# Scratch space: intermediate solution sources, the unpromoted workload sweep,
# and superseded trace sets kept aside during debugging. All of it is either
# reproducible from the commands in the READMEs or deliberately discarded.
/tmp/

# OS
.DS_Store
