diff --git a/flashinfer_bench/bench/eval_config.yaml b/flashinfer_bench/bench/eval_config.yaml
index 2b29c56..37ebb66 100644
--- a/flashinfer_bench/bench/eval_config.yaml
+++ b/flashinfer_bench/bench/eval_config.yaml
@@ -8,3 +8,21 @@ op_type_config:
     extra:
       sampling_validation_trials: 100
       sampling_tvd_threshold: 0.2
+  hca_compress:
+    # Bitwise equality is unsatisfiable here: the op reduces a 128-token softmax
+    # in fp32 and emits fp8, so any reassociation of the sum moves a few output
+    # bytes by one e4m3 code point. 0.999 is the measured separation between a
+    # correct Triton kernel (worst 0.99998256 over the sweep) and eight
+    # deliberate semantic mutations (best 0.96282). Derived in
+    # tasks/hca_compress_c128/eval_config.yaml.
+    required_matched_ratio: 0.999
+    # rtol is tighter than the 1e-2 default because one output, ckv_scale, is an
+    # int8 UE8M0 exponent: a one-exponent error is a factor-of-two error in every
+    # value of its block but shows up as an absolute error of exactly 1, so
+    # detection rests entirely on 1/|e| > rtol. The exponent is representable in
+    # [-22, 120], and 1e-2 goes blind above |e| = 100 -- i.e. precisely on the
+    # huge-magnitude blocks where a dropped exponent does the most damage.
+    # atol stays loose to absorb the one-ulp bf16 noise on ckv, which has large
+    # relative and tiny absolute error. Both derived in the same file.
+    rtol: 1.0e-3
+    atol: 1.0e-2
diff --git a/flashinfer_bench/bench/evaluators/lowbit.py b/flashinfer_bench/bench/evaluators/lowbit.py
index f08e394..88f5db3 100644
--- a/flashinfer_bench/bench/evaluators/lowbit.py
+++ b/flashinfer_bench/bench/evaluators/lowbit.py
@@ -23,7 +23,10 @@ class LowBitEvaluator(DefaultEvaluator):
     @override
     @classmethod
     def can_evaluate(cls, definition: Definition) -> bool:
-        return "moe_fp8_block_scale" in definition.name
+        # hca_compress emits fp8 with a UE8M0 scale per 64 elements, so it is a
+        # low-bit op in exactly the sense this evaluator exists for: what matters
+        # is the fraction of output codes that match, not a max-error bound.
+        return "moe_fp8_block_scale" in definition.name or definition.op_type == "hca_compress"
 
     @override
     @classmethod
